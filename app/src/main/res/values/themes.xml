<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- =============================================================== -->
    <!-- 主应用主题：Material3 DayNight，绑定品牌色 token                  -->
    <!-- =============================================================== -->
    <style name="Theme.NomKeyboard" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:statusBarColor">?attr/colorSurface</item>
        <item name="android:navigationBarColor">?attr/colorSurface</item>
        <item name="android:windowLightNavigationBar">?attr/isLightTheme</item>
        <item name="android:windowLightStatusBar">?attr/isLightTheme</item>
        <item name="android:colorBackground">?attr/colorSurface</item>
    </style>

    <!-- IME 主题保持透明 -->
    <style name="Theme.NomKeyboard.IME" parent="android:Theme.DeviceDefault.Light">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <!-- =============================================================== -->
    <!-- 复用 style                                                       -->
    <!-- =============================================================== -->

    <!-- 分组卡片内的小节标题 -->
    <style name="TextAppearance.App.SectionTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- 分组卡片内的副标题 / 说明文字 -->
    <style name="TextAppearance.App.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">13sp</item>
        <item name="android:lineSpacingMultiplier">1.15</item>
    </style>

    <style name="Widget.App.SettingsRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:gravity">start|center_vertical</item>
        <item name="android:paddingStart">22dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:drawablePadding">26dp</item>
        <item name="android:drawableTint">?attr/colorOnSurfaceVariant</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:textAppearance">?attr/textAppearanceBodyLarge</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:focusable">true</item>
    </style>
    <style name="TextAppearance.App.Group" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <!-- 主按钮（实色填充） -->
    <style name="Widget.App.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- 次按钮（描边） -->
    <style name="Widget.App.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">14dp</item>
        <item name="iconPadding">8dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- 文本按钮 -->
    <style name="Widget.App.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="iconPadding">6dp</item>
        <item name="iconGravity">textStart</item>
    </style>

    <!-- 危险文本按钮（"清空全部"） -->
    <style name="Widget.App.Button.Danger" parent="Widget.Material3.Button.TextButton">
        <item name="android:textColor">?attr/colorError</item>
        <item name="iconTint">?attr/colorError</item>
        <item name="iconPadding">6dp</item>
        <item name="iconGravity">textStart</item>
    </style>

</resources>
